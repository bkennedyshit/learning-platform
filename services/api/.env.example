DATABASE_URL=postgres://postgres:postgres@localhost:5432/learning_platform
DATABASE_REPLICA_URL=postgres://postgres:postgres@localhost:5432/learning_platform

# Learning-agent HTTP surface
# Absolute directory that roots durable learner memory (FileLearnerMemory).
# Must be an ABSOLUTE path — model/UI input never influences this location.
#   Linux/macOS: /var/lib/learning-agent/data
#   Windows:     C:\ProgramData\learning-agent\data
AGENT_DATA_DIR=/var/lib/learning-agent/data
# Absolute path to the generated catalog manifest (apps/learning-app/src/generated/content.json).
# When set, the agent grounds turns in all ~640 real lessons instead of the two
# seed lessons. Must be an ABSOLUTE path; it is service configuration only and is
# never taken from model output, tool input, or request bodies. Leave unset to
# run on the built-in seed fixture.
#   Linux/macOS: /srv/learning-platform/apps/learning-app/src/generated/content.json
#   Windows:     C:\srv\learning-platform\apps\learning-app\src\generated\content.json
AGENT_CATALOG_PATH=/srv/learning-platform/apps/learning-app/src/generated/content.json
# HMAC secret for signing session tokens (must be >= 32 chars).
AGENT_SESSION_SECRET=change-me-to-a-long-random-32+char-secret
# Optional absolute directory for the internal reviewed-draft publication outbox.
# When set, educator.publish_artifact writes an immutable reviewed draft package
# (sanitized artifact + metadata/provenance/approval/version) here AFTER an
# educator approves the exact version. This is NOT the public corpus: a normal
# reviewed commit / static site build consumes the outbox to actually publish.
# The agent/model never writes to the public site directly. Leave unset to only
# signal readiness (status approved_for_reviewed_commit).
#   Linux/macOS: /var/lib/learning-agent/publication-outbox
#   Windows:     C:\ProgramData\learning-agent\publication-outbox
AGENT_PUBLICATION_OUTBOX=
# Enable password-less dev sessions for local development (never in production).
ALLOW_DEV_AUTH=false
# Set true to omit the Secure cookie attribute for local http (never in production).
AGENT_INSECURE_COOKIES=false
# Comma-separated allowlist of CORS origins (empty disables CORS).
AGENT_CORS_ORIGINS=
# Session lifetime in ms (default 12h) and max request body size in bytes.
AGENT_SESSION_TTL_MS=43200000
AGENT_MAX_BODY_BYTES=262144
PORT=8787

# Optional model provider. Defaults to the deterministic scripted planner when
# unset or "stub" — the local no-paid-API path stays fully functional. Set
# LLM_PROVIDER=local (e.g. Ollama), LLM_PROVIDER=hosted (OpenAI-compatible), or
# LLM_PROVIDER=codex to reuse an existing `codex login` ChatGPT subscription
# session. Provider credentials are read server-side only and
# never reach the browser or the model's tool payloads. If provider config is
# missing/invalid the agent fails safely back to deterministic scripted planning.
LLM_PROVIDER=stub
LLM_BASE_URL=
LLM_API_KEY=
LLM_COMPLETION_MODEL=
LLM_EMBEDDING_MODEL=

# ChatGPT subscription-backed local provider. Run `codex login status` first.
# The service invokes an ephemeral, read-only Codex CLI subprocess and never
# reads or sends the cached credential to the browser. This provider supports
# agent completions only; configure local/hosted embeddings for corpus ingestion.
# LLM_PROVIDER=codex
# LLM_COMPLETION_MODEL=gpt-5.5
CODEX_CLI_PATH=codex
CODEX_WORKING_DIRECTORY=
CODEX_TIMEOUT_MS=120000

# Native Google Gemini provider (Generative Language REST API). Set
# LLM_PROVIDER=gemini and provide GEMINI_API_KEY (or reuse LLM_API_KEY). The key
# is sent as an x-goog-api-key header server-side only — never in a URL, never to
# the browser or model tool payloads. Base URL and models have sane defaults:
#   LLM_BASE_URL          (default https://generativelanguage.googleapis.com/v1beta)
#   LLM_COMPLETION_MODEL  (default gemini-2.0-flash)
#   LLM_EMBEDDING_MODEL   (default text-embedding-004)
GEMINI_API_KEY=

# --- Local development quickstart ------------------------------------------
# For local HTTP dev over http://localhost, combine these two so cookie-based
# sessions work without HTTPS AND without weakening production defaults (both
# default to the secure value above; only override them in local shells):
#   ALLOW_DEV_AUTH=true
#   AGENT_INSECURE_COOKIES=true
# Do NOT set either to true in any deployed/production environment.
