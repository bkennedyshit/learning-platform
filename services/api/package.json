{
  "name": "@learning-platform/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "pnpm run build && node dist/migrate.js",
    "start": "node dist/http/server.js",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@learning-platform/agent-contract": "workspace:*",
    "@learning-platform/llm-adapter": "workspace:*",
    "@learning-platform/object-storage": "workspace:^",
    "argon2": "^0.44.0",
    "pg": "^8.16.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.3"
  }
}
