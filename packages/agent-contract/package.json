{
  "name": "@learning-platform/agent-contract",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/index.d.ts",
      "default": "./dist/v1/index.js"
